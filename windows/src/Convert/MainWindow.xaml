<Window x:Class="Convert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert"
        Width="500"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Icon="pack://application:,,,/Convert.ico"
        UseLayoutRounding="True">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Grid x:Name="Root" Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header -->
            <RowDefinition Height="Auto" />  <!-- body -->
            <RowDefinition Height="Auto" />  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="KindBadge" Width="44" Height="44" CornerRadius="8" Margin="0,0,14,0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock x:Name="KindGlyph" FontFamily="{StaticResource IconFont}" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Border>
            <Image x:Name="AppIcon" Width="44" Height="44" Margin="0,0,14,0" Visibility="Collapsed"
                   Source="pack://application:,,,/Convert.ico" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="34"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <StackPanel Grid.Row="1">
            <!-- Empty: drop zone -->
            <Grid x:Name="DropZone" Height="170" Margin="0,0,0,4">
                <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                           Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                           Fill="{DynamicResource SubtleFillColorTransparentBrush}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Drop audio, video, images, documents or PDFs" Margin="0,10,0,12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="Choose files…" HorizontalAlignment="Center" Click="ChooseFiles_Click" />
                </StackPanel>
            </Grid>

            <!-- Files that can't go together -->
            <Border x:Name="MixedNotice" CornerRadius="6" Padding="12,10" Visibility="Collapsed"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock TextWrapping="Wrap"
                           Text="These files can't be converted together. Pick files of one kind (audio, video, images, documents or PDFs)." />
            </Border>

            <!-- Format + settings -->
            <StackPanel x:Name="FormatPanel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Convert to" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="FormatBox" Grid.Column="1" MinWidth="240" HorizontalAlignment="Left"
                              SelectionChanged="FormatBox_SelectionChanged" />
                </Grid>
                <Expander x:Name="AdvancedExpander" Header="Advanced" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                          Expanded="Advanced_Toggled" Collapsed="Advanced_Toggled">
                    <StackPanel x:Name="SettingsPanel" Margin="0,4,0,0" />
                </Expander>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <!-- Idle -->
            <Grid x:Name="IdleFooter">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="TrashBox" VerticalAlignment="Center" Checked="TrashBox_Changed" Unchecked="TrashBox_Changed"
                          ToolTip="Once a file has converted, its original goes to the Recycle Bin. You can restore it from there." />
                <StackPanel x:Name="WarningRow" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" MaxWidth="250" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
                <Button x:Name="ConvertButton" Grid.Column="2" Content="Convert" MinWidth="90" Margin="8,0,0,0" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" Click="Convert_Click" />
            </Grid>

            <!-- Running -->
            <StackPanel x:Name="RunningFooter" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="4" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RunningText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="StopButton" Grid.Column="1" Content="Stop" MinWidth="90" Margin="8,0,0,0" Click="Stop_Click" />
                </Grid>
            </StackPanel>

            <!-- Done -->
            <StackPanel x:Name="DoneFooter" Visibility="Collapsed">
                <StackPanel x:Name="ResultLines" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="ShowButton" Content="Show in Explorer" Click="Show_Click" />
                    <Button x:Name="DoneButton" Content="Done" MinWidth="90" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
